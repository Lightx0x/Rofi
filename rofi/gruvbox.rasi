* {
    bg:       #282828;
    bg-alt:   #3c3836;
    fg:       #ebdbb2;
    fg-dim:   #a89984;
    accent:   #fabd2f;
    urgent:   #fb4934;
    selected: #504945;
    border-c: #665c54;

    font: "Cascadia Code NF 16";
    background-color: @bg;
    text-color: @fg;
    border: 0px;
}

window {
    width: 87.5%;
    location: center;
    anchor: center;
    border: 3px;
    border-color: @border-c;
    border-radius: 10px;
    transparency: "real";
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 0.5em;
    border: 0px 0px 2px 0px;
    border-color: @border-c;
    color: @fg;
    children: [ prompt, entry ];
}

prompt {
    margin: 0em 0.3em 0em 0em;
    text-color: @accent;
    background-color: inherit;
}

entry {
    text-color: @fg;
    cursor: pointer;
    background-color: inherit;
}

message {
    padding: 0.3em 0.5em;
    border: 0px 0px 1px 0px;
    border-color: @border-c;
}

listview {
    padding: 0.3em;
    lines: 6;
    columns: 2;
    spacing: 0.15em;
    dynamic: false;
    border: 0px;
}

element {
    padding: 0.3em 0.4em;
    border-radius: 6px;
    text-color: @fg;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    background-color: inherit;
    text-color: inherit;
    size: 2.5em;
}

element selected.normal {
    background-color: @selected;
    text-color: @accent;
}

element normal active {
    text-color: @accent;
}

element normal urgent {
    text-color: @urgent;
}

element selected active {
    background-color: @selected;
    text-color: @accent;
}

element alternate.normal {
    background-color: @bg;
}

case-indicator {
    text-color: inherit;
    background-color: inherit;
}

button {
    padding: 0.3em;
    text-color: @fg-dim;
    background-color: @bg-alt;
    border: 0px;
    border-radius: 6px;
}

button selected normal {
    background-color: @selected;
    text-color: @accent;
}
